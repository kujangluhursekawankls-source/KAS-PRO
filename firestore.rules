rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Registered user accounts directory for multi-browser & multi-device sync
    match /accounts/{accountId} {
      allow read, write: if isValidId(accountId);
    }

    // User document and nested sub-collections
    match /users/{userId} {
      allow read, write: if isValidId(userId);

      match /{allSubcollections=**} {
        allow read, write: if isValidId(userId);
      }
    }

    // Connection health test doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
